{
  "name": "@lumavok/backend",
  "version": "1.0.0",
  "description": "Lumavok API for property, account and seller workflows",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate --schema=../database/schema.prisma && tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate --schema=../database/schema.prisma",
    "db:migrate": "node ../database/scripts/deploy-reviewed.cjs --apply",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@prisma/client": "5.20.0",
    "@supabase/supabase-js": "2.118.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "8.7.1",
    "helmet": "^8.0.0",
    "multer": "^2.3.0",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@electric-sql/pglite-socket": "0.0.17",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/supertest": "7.2.1",
    "prisma": "5.20.0",
    "supertest": "7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
