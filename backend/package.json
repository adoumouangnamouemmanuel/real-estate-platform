{
  "name": "@lumavok/backend",
  "version": "1.0.0",
  "description": "Backend API service for the Lumavok Real Estate Platform",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "cd ../database/full-database-design && npx prisma generate",
    "db:migrate": "cd ../database/full-database-design && npx prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/client": "5.20.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.19.43",
    "prisma": "5.20.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
