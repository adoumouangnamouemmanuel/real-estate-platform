PORT=4000
NODE_ENV=development
# Supply only the non-owner runtime URL to the application through your secret manager.
DATABASE_URL=
# DIRECT_URL belongs only in the separate migration deployment environment.
SUPABASE_URL=https://haxzufwizwqfrqzzzmsa.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Server only, isolated from the database runtime; never NEXT_PUBLIC_.
SUPABASE_STORAGE_KEY=
AUTH_REDIRECT_URL=http://localhost:3000/reset-password
AUTH_COOKIE_NAME=refresh_token
REFRESH_TOKEN_EXPIRES_IN_DAYS=7
CORS_ORIGIN=http://localhost:3000
CONTENT_READ_MODE=localized
# Set only for a verified proxy chain; deny direct access that bypasses it.
TRUST_PROXY_HOPS=0
