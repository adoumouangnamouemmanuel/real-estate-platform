// database/schema.prisma
// LUMAVOK Real Estate Platform — Single source of truth for all data models.
// Owner: Clement (DBA). Built from README.md + ER-Diagram-Code.md (29/06/2026).
//
// NOTE ON PRIMARY KEYS: the dbdiagram.io source (ER-Diagram-Code.md) shows
// `id INT PK` on every table. That was a drafting mistake in the diagram —
// confirmed with the project owner — and this schema uses cuid() string IDs
// instead, consistent with the rest of the platform's ID strategy (no
// sequential-ID enumeration in public URLs like /properties/:id).

generator client {
  provider = "prisma-client-js"
  output   = "../../backend/node_modules/.prisma/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum Role {
  USER
  PROPERTY_DEVELOPER
  ADMIN
}

enum PropertyCategory {
  APARTMENT
  HOUSE
  LAND
  COMMERCIAL
  OFFICE
}

enum ListingType {
  SALE
  RENT
}

enum PropertyStatus {
  DRAFT // hidden
  ACTIVE // visible
  RESERVED // hidden
  SOLD // hidden
  SUSPENDED // hidden
}

enum MediaType {
  IMAGE
  VIDEO
}

enum TransactionType {
  SALE
  RENT
  OTHER
}

enum NotificationType {
  PROPERTY_LIKED
  PROPERTY_VIEWED_MILESTONE
  APPOINTMENT_REQUESTED
  APPOINTMENT_CONFIRMED
  APPOINTMENT_CANCELLED
  APPOINTMENT_RESCHEDULED
  APPOINTMENT_COMPLETED
  APPOINTMENT_NO_SHOW
  LISTING_PUBLISHED
  LISTING_SUSPENDED
  DRAFT_REMINDER
  SYSTEM
}

enum ReportTargetType {
  PROPERTY
  PROPERTY_DEVELOPER
}

enum ReportStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

enum AppointmentStatus {
  REQUESTED
  CONFIRMED
  RESCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum NotificationStatus {
  UNREAD
  READ
  ARCHIVED
}

// ─────────────────────────────────────────────
// 1.1 User — the login account
// ─────────────────────────────────────────────

model User {
  id                    String    @id @default(cuid())
  email                 String    @unique
  passwordHash          String    @map("password_hash")
  role                  Role
  createdAt             DateTime  @default(now()) @map("created_at")
  fullName              String?   @map("full_name")
  authUserId            String?   @unique @map("auth_user_id") @db.Uuid // auth.users FK is managed by SQL, outside Prisma's public schema.
  preferredLanguageCode String?   @map("preferred_language_code")
  preferredLanguage     Language? @relation(fields: [preferredLanguageCode], references: [code])

  sellerApprovals    PropertyDeveloper[]       @relation("SellerApprover")
  clientAppointments Appointment[]             @relation("AppointmentClient")
  developerProfile   PropertyDeveloper?
  favorites          PropertyFavorite[]
  ratingsGiven       PropertyDeveloperRating[]
  reports            Report[]
  refreshTokens      RefreshToken[]

  @@map("user")
}

// ─────────────────────────────────────────────
// 1.2 PropertyDeveloper — the seller/agent business profile
// "Developer" = property seller, not software engineer.
// ─────────────────────────────────────────────

model PropertyDeveloper {
  id                   String    @id @default(cuid())
  userId               String    @unique @map("user_id")
  businessName         String?   @map("business_name")
  whatsappNumber       String    @map("whatsapp_number")
  phoneNumber          String    @map("phone_number")
  profileImageUrl      String    @map("profile_image_url")
  profileImagePublicId String    @map("profile_image_public_id")
  coverImageUrl        String?   @map("cover_image_url")
  coverImagePublicId   String?   @map("cover_image_public_id")
  bio                  String?
  yearsOfExperience    Int?      @map("years_of_experience")
  specialization       String?
  languagesSpoken      String?   @map("languages_spoken")
  address              String?
  city                 String // free-text city of operation, distinct from the normalized City lookup table used by Property
  isVerified           Boolean   @default(false) @map("is_verified")
  verifiedSince        DateTime? @map("verified_since")
  averageRating        Decimal   @default(0) @map("average_rating") @db.Decimal(3, 2)
  totalRatings         Int       @default(0) @map("total_ratings")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  deletedAt            DateTime? @map("deleted_at") // soft delete

  slug               String                         @unique
  sellerStatus       String                         @default("PENDING") @map("seller_status")
  sourceLanguageCode String?                        @map("source_language_code")
  sourceLanguage     Language?                      @relation("DeveloperSource", fields: [sourceLanguageCode], references: [code])
  activatedAt        DateTime?                      @map("activated_at") @db.Timestamptz(3)
  activatedByUserId  String?                        @map("activated_by_user_id")
  activatedBy        User?                          @relation("SellerApprover", fields: [activatedByUserId], references: [id], onDelete: Restrict)
  publicEmail        String?                        @map("public_email")
  cityId             String?                        @map("city_id")
  cityRef            City?                          @relation(fields: [cityId], references: [id], onDelete: Restrict)
  translations       PropertyDeveloperTranslation[]
  targetReports      Report[]                       @relation("ReportedDeveloper")

  user          User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  properties    Property[]
  ratings       PropertyDeveloperRating[]
  notifications Notification[]
  appointments  Appointment[]

  @@index([isVerified], map: "idx_developer_verified")
  @@index([averageRating], map: "idx_developer_rating")
  @@index([city], map: "idx_developer_city")
  @@map("property_developer")
}

// ─────────────────────────────────────────────
// 1.3 Property — the actual listing
// ─────────────────────────────────────────────

model Property {
  id                  String           @id @default(cuid())
  propertyDeveloperId String           @map("property_developer_id")
  title               String
  slug                String           @unique
  description         String
  category            PropertyCategory
  listingType         ListingType      @map("listing_type")
  price               Decimal          @db.Decimal(15, 2)
  address             String
  cityId              String           @map("city_id")
  districtId          String?          @map("district_id")
  bedrooms            Int?
  bathrooms           Int?
  carSpaces           Int?             @map("car_spaces")
  landSizeSqM         Decimal?         @map("land_size_sq_m") @db.Decimal(10, 2)
  buildingSizeSqM     Decimal?         @map("building_size_sq_m") @db.Decimal(10, 2)
  yearBuilt           Int?             @map("year_built")
  status              PropertyStatus   @default(DRAFT)
  viewCount           Int              @default(0) @map("view_count")
  whatsappClickCount  Int              @default(0) @map("whatsapp_click_count")
  favoriteCount       Int              @default(0) @map("favorite_count") // denormalized counter, kept in sync with PropertyFavorite by a narrow SQL trigger
  publishedAt         DateTime?        @map("published_at")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")
  deletedAt           DateTime?        @map("deleted_at") // soft delete

  sourceLanguageCode String?               @map("source_language_code")
  sourceLanguage     Language?             @relation("PropertySource", fields: [sourceLanguageCode], references: [code])
  currencyCode       String?               @map("currency_code")
  rentPeriod         String?               @map("rent_period")
  rowVersion         Int                   @default(1) @map("row_version")
  translations       PropertyTranslation[]
  targetReports      Report[]              @relation("ReportedProperty")

  developer    PropertyDeveloper   @relation(fields: [propertyDeveloperId], references: [id])
  cityRef      City                @relation(fields: [cityId], references: [id])
  district     District?           @relation(fields: [districtId, cityId], references: [id, cityId], onDelete: Restrict, onUpdate: Cascade, map: "property_district_city_fkey")
  features     PropertyFeature[]
  media        PropertyMedia[]
  favorites    PropertyFavorite[]
  analytics    PropertyAnalytics[]
  appointments Appointment[]

  @@unique([id, propertyDeveloperId], map: "uq_property_id_developer")
  @@index([propertyDeveloperId, updatedAt(sort: Desc), id], map: "idx_property_owner_updated")
  @@index([status], map: "idx_property_status")
  @@index([cityId], map: "idx_property_city")
  @@index([districtId], map: "idx_property_district")
  @@index([listingType], map: "idx_property_listing_type")
  @@index([price], map: "idx_property_price")
  @@index([propertyDeveloperId], map: "idx_property_developer")
  @@index([category], map: "idx_property_category")
  @@index([createdAt], map: "idx_property_created")
  @@map("property")
}

// ─────────────────────────────────────────────
// 1.4 City — list of cities (Villes)
// ─────────────────────────────────────────────

model City {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  countryCode String              @default("BF") @map("country_code")
  developers  PropertyDeveloper[]
  districts   District[]
  properties  Property[]

  @@map("city")
}

// ─────────────────────────────────────────────
// 1.5 District — precise location within a city (Quartier)
// ─────────────────────────────────────────────

model District {
  id        String   @id @default(cuid())
  cityId    String   @map("city_id")
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  city       City       @relation(fields: [cityId], references: [id], onDelete: Cascade)
  properties Property[]

  @@unique([id, cityId], map: "uq_district_id_city")
  @@unique([cityId, name], map: "idx_district_city_name") // "Dafra" can exist in both Ouagadougou and Bobo-Dioulasso
  @@index([cityId], map: "idx_district_city")
  @@map("district")
}

// ─────────────────────────────────────────────
// 1.6 Feature — list of amenities
// ─────────────────────────────────────────────

model Feature {
  id          String   @id @default(cuid())
  featureName String   @unique @map("feature_name")
  category    String?
  iconName    String?  @map("icon_name")
  createdAt   DateTime @default(now()) @map("created_at")

  code               String               @unique
  sourceLanguageCode String?              @map("source_language_code")
  sourceLanguage     Language?            @relation("FeatureSource", fields: [sourceLanguageCode], references: [code])
  translations       FeatureTranslation[]
  properties         PropertyFeature[]

  @@map("feature")
}

// ─────────────────────────────────────────────
// 1.7 PropertyFeature — links amenities to properties (M:N join)
// ─────────────────────────────────────────────

model PropertyFeature {
  id         String   @id @default(cuid())
  propertyId String   @map("property_id")
  featureId  String   @map("feature_id")
  createdAt  DateTime @default(now()) @map("created_at")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  feature  Feature  @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@unique([propertyId, featureId], map: "uq_property_feature")
  @@index([propertyId], map: "idx_property_feature_property")
  @@index([featureId], map: "idx_property_feature_feature")
  @@map("property_feature")
}

// ─────────────────────────────────────────────
// 1.8 PropertyMedia — images and videos
// ─────────────────────────────────────────────

model PropertyMedia {
  id         String    @id @default(cuid())
  propertyId String    @map("property_id")
  url        String
  publicId   String    @map("public_id")
  mediaType  MediaType @default(IMAGE) @map("media_type")
  isPrimary  Boolean   @default(false) @map("is_primary")
  order      Int       @default(0)
  altText    String?   @map("alt_text")
  createdAt  DateTime  @default(now()) @map("created_at")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  storageProvider String  @default("legacy") @map("storage_provider")
  storageKey      String? @map("storage_key")

  @@unique([propertyId, order], map: "uq_media_property_order")
  @@index([propertyId], map: "idx_media_property")
  @@index([propertyId, isPrimary], map: "idx_media_primary")
  @@map("property_media")
}

// ─────────────────────────────────────────────
// 1.9 PropertyFavorite — user's saved properties (M:N join)
// ─────────────────────────────────────────────

model PropertyFavorite {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  propertyId String   @map("property_id")
  createdAt  DateTime @default(now()) @map("created_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId], map: "uq_favorite_user_property")
  @@index([userId], map: "idx_favorite_user")
  @@index([propertyId], map: "idx_favorite_property")
  @@map("property_favorite")
}

// ─────────────────────────────────────────────
// 1.10 PropertyDeveloperRating — trust scores
// ─────────────────────────────────────────────

model PropertyDeveloperRating {
  id                  String           @id @default(cuid())
  raterUserId         String           @map("rater_user_id")
  propertyDeveloperId String           @map("property_developer_id")
  score               Int // 1-5, CHECK constraint added in migration SQL
  comment             String?
  transactionType     TransactionType? @map("transaction_type")
  createdAt           DateTime         @default(now()) @map("created_at")

  rater     User              @relation(fields: [raterUserId], references: [id], onDelete: Cascade)
  developer PropertyDeveloper @relation(fields: [propertyDeveloperId], references: [id], onDelete: Cascade)

  @@unique([raterUserId, propertyDeveloperId], map: "uq_rating_rater_developer")
  @@index([propertyDeveloperId], map: "idx_rating_developer")
  @@index([raterUserId], map: "idx_rating_rater")
  @@map("property_developer_rating")
}

// ─────────────────────────────────────────────
// 1.11 Notification — alerts for sellers
// ─────────────────────────────────────────────

model Notification {
  id                  String             @id @default(cuid())
  propertyDeveloperId String             @map("property_developer_id")
  type                NotificationType
  title               String
  message             String
  metadata            Json?
  readAt              DateTime?          @map("read_at")
  createdAt           DateTime           @default(now()) @map("created_at")
  status              NotificationStatus @default(UNREAD)
  templateKey         String?            @map("template_key")
  templateParams      Json?              @map("template_params")
  link                String?

  developer PropertyDeveloper @relation(fields: [propertyDeveloperId], references: [id], onDelete: Cascade)

  @@index([propertyDeveloperId], map: "idx_notification_developer")
  @@index([propertyDeveloperId, status], map: "idx_notification_status")
  @@map("notification")
}

// ─────────────────────────────────────────────
// 1.12 PropertyAnalytics — daily performance rollup
// ─────────────────────────────────────────────

model PropertyAnalytics {
  id             String   @id @default(cuid())
  propertyId     String   @map("property_id")
  date           DateTime @db.Date
  views          Int      @default(0)
  whatsappClicks Int      @default(0) @map("whatsapp_clicks")
  favorites      Int      @default(0)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, date], map: "idx_analytics_property_date")
  @@map("property_analytics")
}

// ─────────────────────────────────────────────
// 1.13 Report — user complaints / admin moderation
// Polymorphic target (PROPERTY or PROPERTY_DEVELOPER) — see DATABASE.md
// for why target_id has no DB-level foreign key.
// ─────────────────────────────────────────────

model Report {
  id             String           @id @default(cuid())
  reporterUserId String?          @map("reporter_user_id") // nullable - anonymous reports allowed
  targetType     ReportTargetType @map("target_type")
  targetId       String           @map("target_id")
  reason         String
  description    String?
  status         ReportStatus     @default(OPEN)
  resolutionNote String?          @map("resolution_note")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  propertyId          String?            @map("property_id")
  propertyDeveloperId String?            @map("property_developer_id")
  property            Property?          @relation("ReportedProperty", fields: [propertyId], references: [id], onDelete: Restrict)
  developer           PropertyDeveloper? @relation("ReportedDeveloper", fields: [propertyDeveloperId], references: [id], onDelete: Restrict)
  reporter            User?              @relation(fields: [reporterUserId], references: [id], onDelete: SetNull)

  @@index([reporterUserId], map: "idx_report_reporter")
  @@index([status], map: "idx_report_status")
  @@index([targetType, targetId], map: "idx_report_target")
  @@map("report")
}

// ─────────────────────────────────────────────
// 1.14 Appointment — property viewing requests
// ─────────────────────────────────────────────

model Appointment {
  id                   String            @id @default(cuid())
  propertyId           String            @map("property_id")
  propertyDeveloperId  String            @map("property_developer_id")
  clientUserId         String            @map("client_user_id")
  clientName           String            @map("client_name")
  scheduledFor         DateTime          @map("scheduled_for")
  previousScheduledFor DateTime?         @map("previous_scheduled_for")
  status               AppointmentStatus @default(REQUESTED)
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")

  client    User                 @relation("AppointmentClient", fields: [clientUserId], references: [id])
  developer PropertyDeveloper    @relation(fields: [propertyDeveloperId], references: [id], onDelete: Cascade)
  property  Property             @relation(fields: [propertyId, propertyDeveloperId], references: [id, propertyDeveloperId], onDelete: Restrict, onUpdate: Cascade, map: "appointment_property_developer_fkey")
  history   AppointmentHistory[]

  @@index([propertyDeveloperId], map: "idx_appointment_developer")
  @@index([propertyId], map: "idx_appointment_property")
  @@index([clientUserId], map: "idx_appointment_client")
  @@index([status], map: "idx_appointment_status")
  @@index([scheduledFor], map: "idx_appointment_scheduled")
  @@map("appointment")
}

model AppointmentHistory {
  id            String   @id @default(cuid())
  appointmentId String   @map("appointment_id")
  type          String
  message       String
  createdAt     DateTime @default(now()) @map("created_at")

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId], map: "idx_appointment_history_appointment")
  @@map("appointment_history")
}

// ─────────────────────────────────────────────
// 1.15 RefreshToken — secure auto-login
// ─────────────────────────────────────────────

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  userAgent String?   @map("user_agent")
  ipAddress String?   @map("ip_address")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_token_user")
  @@index([tokenHash], map: "idx_token_hash")
  @@map("refresh_token")
}

// CHECK constraints, partial indexes, auth FK, security triggers and RLS live in migrations.
model Language {
  code                  String                         @id
  isActive              Boolean                        @default(true) @map("is_active")
  preferredUsers        User[]
  propertySources       Property[]                     @relation("PropertySource")
  developerSources      PropertyDeveloper[]            @relation("DeveloperSource")
  featureSources        Feature[]                      @relation("FeatureSource")
  propertyTranslations  PropertyTranslation[]
  developerTranslations PropertyDeveloperTranslation[]
  featureTranslations   FeatureTranslation[]
  defaults              AppSettings[]                  @relation("DefaultLanguage")
  fallbacks             AppSettings[]                  @relation("FallbackLanguage")

  @@map("language")
}

model AppSettings {
  id                   Int      @id @default(1)
  defaultLanguageCode  String   @default("fr") @map("default_language_code")
  fallbackLanguageCode String   @default("fr") @map("fallback_language_code")
  defaultLanguage      Language @relation("DefaultLanguage", fields: [defaultLanguageCode], references: [code])
  fallbackLanguage     Language @relation("FallbackLanguage", fields: [fallbackLanguageCode], references: [code])

  @@map("app_settings")
}

model PropertyTranslation {
  propertyId   String   @map("property_id")
  languageCode String   @map("language_code")
  title        String
  description  String
  isPublished  Boolean  @default(false) @map("is_published")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  property     Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  language     Language @relation(fields: [languageCode], references: [code], onDelete: Restrict)

  @@id([propertyId, languageCode])
  @@map("property_translation")
}

model FeatureTranslation {
  featureId    String   @map("feature_id")
  languageCode String   @map("language_code")
  name         String
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  feature      Feature  @relation(fields: [featureId], references: [id], onDelete: Cascade)
  language     Language @relation(fields: [languageCode], references: [code], onDelete: Restrict)

  @@id([featureId, languageCode])
  @@map("feature_translation")
}

model PropertyDeveloperTranslation {
  developerId    String            @map("developer_id")
  languageCode   String            @map("language_code")
  bio            String?
  specialization String?
  updatedAt      DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  developer      PropertyDeveloper @relation(fields: [developerId], references: [id], onDelete: Cascade)
  language       Language          @relation(fields: [languageCode], references: [code], onDelete: Restrict)

  @@id([developerId, languageCode])
  @@map("property_developer_translation")
}
