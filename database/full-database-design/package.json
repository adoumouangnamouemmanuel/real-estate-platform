{
  "name": "@lumavok/database",
  "version": "1.0.0",
  "private": true,
  "description": "Prisma schema, migrations, and seed scripts for the Lumavok Real Estate Platform",
  "type": "commonjs",
  "scripts": {
    "generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "node scripts/deploy-reviewed.cjs --apply",
    "seed": "node scripts/seed-local.cjs",
    "studio": "prisma studio",
    "test": "node --test tests/*.test.cjs",
    "migrate:preflight": "node scripts/deploy-reviewed.cjs",
    "content:check": "node scripts/backfill-reviewed-content.cjs",
    "content:apply": "node scripts/backfill-reviewed-content.cjs --apply"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.14",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.19.43",
    "prisma": "5.20.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "@prisma/client": "5.20.0",
    "bcryptjs": "^2.4.3",
    "pg": "8.16.3"
  }
}
